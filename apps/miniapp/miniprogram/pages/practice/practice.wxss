.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}

.hero,
.section,
.question-card,
.result,
.empty,
.error {
  border: 1rpx solid #d9e5df;
  border-radius: 16rpx;
  background: #ffffff;
  padding: 24rpx;
}

.hero {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 18rpx;
}

.eyebrow,
.label,
.hint {
  display: block;
  color: #64756f;
  font-size: 24rpx;
}

.title {
  display: block;
  margin-top: 6rpx;
  color: #14251f;
  font-size: 40rpx;
  font-weight: 700;
}

.summary {
  display: block;
  margin-top: 10rpx;
  color: #5c6f68;
  font-size: 26rpx;
  line-height: 1.45;
}

.small {
  margin: 0;
  min-width: 170rpx;
  color: #2f63e8;
  background: #eef4ff;
  font-size: 24rpx;
}

.picker-row {
  min-height: 76rpx;
  border: 1rpx solid #d9e5df;
  border-radius: 12rpx;
  padding: 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #f7faf8;
}

.picker-row text:last-child {
  max-width: 430rpx;
  color: #2f63e8;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.question-meta {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
  margin-bottom: 18rpx;
}

.question-meta text {
  padding: 6rpx 12rpx;
  border-radius: 999rpx;
  color: #64756f;
  background: #f0f5f2;
  font-size: 22rpx;
}

.prompt {
  display: block;
  color: #14251f;
  font-size: 31rpx;
  line-height: 1.6;
}

.choices,
.field,
.suggestions {
  display: grid;
  gap: 12rpx;
  margin-top: 20rpx;
}

.choice {
  margin: 0;
  padding: 18rpx;
  border: 1rpx solid #d9e5df;
  border-radius: 12rpx;
  color: #14251f;
  background: #f7faf8;
  text-align: left;
  font-size: 28rpx;
}

.choice.active {
  border-color: #2f63e8;
  color: #2f63e8;
  background: #eef4ff;
}

textarea {
  min-height: 180rpx;
  border: 1rpx solid #d9e5df;
  border-radius: 12rpx;
  padding: 18rpx;
  box-sizing: border-box;
  background: #f7faf8;
}

.actions {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 12rpx;
  margin-top: 22rpx;
}

.primary {
  color: #ffffff;
  background: #2f63e8;
}

.secondary {
  color: #2f63e8;
  background: #eef4ff;
}

.score {
  display: block;
  color: #0f8f8f;
  font-size: 46rpx;
  font-weight: 800;
}

.feedback,
.answer,
.suggestions text {
  display: block;
  color: #14251f;
  font-size: 27rpx;
  line-height: 1.55;
}

.label {
  margin-top: 18rpx;
}

.error {
  color: #d43b3b;
  background: #fff5f5;
}

.empty {
  color: #64756f;
  text-align: center;
}
