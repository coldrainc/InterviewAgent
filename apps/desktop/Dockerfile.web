ARG NODE_IMAGE=node:22-alpine
ARG NGINX_IMAGE=nginx:1.27-alpine
FROM ${NODE_IMAGE} AS build

WORKDIR /app
COPY apps/desktop/package.json apps/desktop/package-lock.json ./
RUN npm ci --ignore-scripts

COPY apps/desktop/ ./
ARG VITE_INTERVIEW_AGENT_API_URL=/api
ENV VITE_INTERVIEW_AGENT_API_URL=$VITE_INTERVIEW_AGENT_API_URL
RUN npm run build

FROM ${NGINX_IMAGE}

COPY deploy/nginx-container.conf /etc/nginx/conf.d/default.conf
COPY --from=build /app/dist /usr/share/nginx/html

EXPOSE 8080

HEALTHCHECK --interval=15s --timeout=4s --start-period=5s --retries=6 \
  CMD wget -q -O - http://127.0.0.1:8080/healthz >/dev/null || exit 1
