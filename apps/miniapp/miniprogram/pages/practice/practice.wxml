<view class="page">
  <view class="hero">
    <view>
      <text class="eyebrow">Practice</text>
      <text class="title">刷题训练</text>
      <text class="summary">按面试类型做题、提交答案、查看解析和复盘建议。</text>
    </view>
    <button class="small" bindtap="seedQuestions" loading="{{loading}}">初始化样题</button>
  </view>

  <view class="section">
    <picker mode="selector" range="{{categories}}" range-key="label" bindchange="onCategoryChange">
      <view class="picker-row">
        <text>训练类型</text>
        <text>{{selectedCategoryLabel}}</text>
      </view>
    </picker>
    <text class="hint">当前筛选共 {{total}} 道题</text>
  </view>

  <view wx:if="{{error}}" class="error">{{error}}</view>

  <view wx:if="{{currentQuestion}}" class="question-card">
    <view class="question-meta">
      <text>{{currentQuestion.exam_year}}</text>
      <text>{{currentQuestion.exam_name}}</text>
      <text>{{currentQuestion.subject}}</text>
      <text>{{currentQuestion.question_type}}</text>
    </view>
    <text class="prompt">{{currentQuestion.prompt}}</text>

    <view wx:if="{{currentQuestion.choices.length}}" class="choices">
      <button
        wx:for="{{currentQuestion.choices}}"
        wx:key="key"
        class="choice {{answer === item.key ? 'active' : ''}}"
        data-value="{{item.key}}"
        bindtap="chooseOption"
      >
        {{item.key}}. {{item.text}}
      </button>
    </view>

    <view wx:else class="field">
      <text class="label">我的答案</text>
      <textarea value="{{answer}}" bindinput="onAnswerInput" placeholder="写下你的答题思路，提交后查看参考答案和复盘建议。" />
    </view>

    <view class="actions">
      <button class="secondary" bindtap="nextQuestion">下一题</button>
      <button class="primary" bindtap="submit" loading="{{loading}}">提交答案</button>
    </view>
  </view>

  <view wx:else class="empty">
    <text>暂无题目，可以初始化样题或切换训练类型。</text>
  </view>

  <view wx:if="{{result}}" class="result">
    <text class="score">{{result.score}} 分</text>
    <text class="feedback">{{result.feedback}}</text>
    <text class="label">参考答案</text>
    <text class="answer">{{result.reference_answer}}</text>
    <text class="label">解析</text>
    <text class="answer">{{result.explanation}}</text>
    <text class="label">复盘建议</text>
    <view class="suggestions">
      <text wx:for="{{result.suggestions}}" wx:key="*this">- {{item}}</text>
    </view>
  </view>
</view>
