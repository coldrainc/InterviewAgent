.page { min-height: 100vh; padding: 32rpx 28rpx 56rpx; box-sizing: border-box; background: #f3f6f4; }
.page-head { margin-bottom: 28rpx; }
.eyebrow { display: block; color: #27735f; font-size: 22rpx; font-weight: 700; }
.title { display: block; margin-top: 8rpx; color: #15241f; font-size: 52rpx; font-weight: 800; }
.summary, .muted { display: block; margin-top: 7rpx; color: #65746f; font-size: 25rpx; line-height: 1.5; }
.auth-card, .profile-card, .stats, .menu, .notice { border-radius: 16rpx; background: #fff; }
.auth-card { display: grid; gap: 16rpx; padding: 28rpx; }
.section-title, .name, .menu-title { display: block; color: #15241f; font-size: 32rpx; font-weight: 750; }
input { min-height: 86rpx; padding: 0 20rpx; border-radius: 12rpx; background: #f3f6f4; }
.primary { color: #fff; background: #315be8; }
.wechat { color: #176b50; background: #e2f3ed; }
.text-button { color: #315be8; background: transparent; font-size: 25rpx; }
.profile-card { display: flex; align-items: center; gap: 20rpx; padding: 28rpx; }
.avatar { width: 90rpx; height: 90rpx; flex: 0 0 auto; border-radius: 45rpx; color: #fff; background: #27735f; font-size: 34rpx; font-weight: 800; text-align: center; line-height: 90rpx; }
.profile-main { min-width: 0; }
.profile-main .muted { overflow: hidden; white-space: nowrap; text-overflow: ellipsis; }
.stats { margin-top: 18rpx; padding: 24rpx; display: grid; grid-template-columns: 1fr 1fr; gap: 16rpx; }
.stats > view { padding: 20rpx; border-radius: 12rpx; background: #f3f6f4; }
.stat { display: block; margin-top: 8rpx; color: #27735f; font-size: 40rpx; font-weight: 800; }
.menu { margin-top: 18rpx; overflow: hidden; }
.menu-row { min-height: 100rpx; padding: 22rpx 26rpx; border-bottom: 1rpx solid #e5ebe8; display: flex; align-items: center; justify-content: space-between; gap: 20rpx; }
.menu-row:last-child { border-bottom: 0; }
.menu-title { font-size: 29rpx; }
.menu-row > text { color: #8b9893; font-size: 42rpx; }
.logout { margin-top: 26rpx; color: #b33342; background: #fff1f3; }
.notice { margin-bottom: 18rpx; padding: 20rpx; }
.notice.error { color: #a42635; background: #fff1f3; }
