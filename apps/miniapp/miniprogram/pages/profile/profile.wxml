<view class="page">
  <view class="page-head">
    <text class="eyebrow">MINE</text>
    <text class="title">我的</text>
    <text class="summary">管理简历、面试记录与账号</text>
  </view>

  <view wx:if="{{error}}" class="notice error">{{error}}</view>

  <view wx:if="{{!authenticated}}" class="auth-card">
    <text class="section-title">{{registerMode ? '创建账号' : '欢迎回来'}}</text>
    <text class="muted">登录后，学习数据只会同步到你的账号。</text>
    <input wx:if="{{registerMode}}" value="{{displayName}}" data-key="displayName" bindinput="onInput" placeholder="你的称呼" />
    <input value="{{email}}" data-key="email" bindinput="onInput" placeholder="邮箱" />
    <input value="{{password}}" data-key="password" bindinput="onInput" password placeholder="密码，至少 8 位" />
    <button class="primary" loading="{{loading}}" bindtap="submitAuth">{{registerMode ? '注册并开始' : '登录'}}</button>
    <button class="wechat" loading="{{loading}}" bindtap="wechatLogin">微信快捷登录</button>
    <button class="text-button" bindtap="toggleMode">{{registerMode ? '已有账号，去登录' : '没有账号，立即注册'}}</button>
  </view>

  <block wx:else>
    <view class="profile-card">
      <view class="avatar">我</view>
      <view class="profile-main">
        <text class="name">{{account && account.display_name || 'Interview Agent 用户'}}</text>
        <text class="muted">{{account && account.email || '学习进度已安全同步'}}</text>
      </view>
    </view>

    <view class="stats">
      <view><text class="muted">剩余试用</text><text class="stat">{{account ? account.trial_uses_remaining : '-'}}</text></view>
      <view><text class="muted">积分余额</text><text class="stat">{{account ? account.credit_balance : '-'}}</text></view>
    </view>

    <view class="menu">
      <view class="menu-row" bindtap="openResumes"><view><text class="menu-title">简历管理</text><text class="muted">上传、选择和删除简历</text></view><text>›</text></view>
      <view class="menu-row" bindtap="openHistory"><view><text class="menu-title">面试历史</text><text class="muted">恢复会话与查看训练记录</text></view><text>›</text></view>
      <view class="menu-row" bindtap="openPrivacy"><view><text class="menu-title">隐私与数据</text><text class="muted">查看数据使用与删除说明</text></view><text>›</text></view>
    </view>

    <button class="logout" bindtap="logout">退出登录</button>
  </block>
</view>
