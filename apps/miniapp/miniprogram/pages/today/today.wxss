.page {
  min-height: 100vh;
  padding: 28rpx;
  box-sizing: border-box;
  background: #eef4f1;
}

.header,
.next-card,
.task-card,
.empty-state,
.notice {
  border: 1rpx solid #d9e5df;
  border-radius: 16rpx;
  background: #ffffff;
}

.header {
  padding: 24rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
}

.eyebrow,
.section-label,
.muted,
.task-meta,
.verification-reason,
.summary,
.notice-detail {
  display: block;
  color: #64756f;
  font-size: 24rpx;
}

.title {
  display: block;
  margin: 6rpx 0;
  color: #14251f;
  font-size: 40rpx;
  font-weight: 800;
}

.icon-button {
  width: 72rpx;
  height: 72rpx;
  padding: 0;
  color: #2f63e8;
  background: #eef5ff;
  font-size: 36rpx;
}

button::after { border: 0; }

.notice {
  margin-top: 18rpx;
  padding: 20rpx;
  display: grid;
  gap: 5rpx;
}

.notice.warning,
.risk-item.warning {
  color: #8a4b08;
  border-color: #e4b96d;
  background: #fff8e8;
}

.notice.error {
  color: #9f2525;
  border-color: #efc3c3;
  background: #fff7f7;
}

.next-card {
  margin-top: 18rpx;
  padding: 26rpx;
  display: grid;
  gap: 12rpx;
}

.next-title,
.empty-title,
.section-title,
.task-title {
  color: #14251f;
  font-weight: 750;
}

.next-title { font-size: 34rpx; }
.section-title { display: block; margin-top: 5rpx; font-size: 30rpx; }

.primary {
  margin: 8rpx 0 0;
  color: #ffffff;
  background: #2f63e8;
}

.risk-list {
  margin-top: 18rpx;
  display: grid;
  gap: 10rpx;
}

.risk-item {
  padding: 16rpx 20rpx;
  border: 1rpx solid #c8dafc;
  border-radius: 12rpx;
  color: #234ed1;
  background: #eef5ff;
  font-size: 24rpx;
}

.section-heading { margin: 28rpx 4rpx 14rpx; }
.task-list { display: grid; gap: 14rpx; }

.task-card {
  padding: 20rpx;
  display: grid;
  grid-template-columns: 54rpx minmax(0, 1fr) auto;
  align-items: center;
  gap: 14rpx;
}

.task-card:active { background: #f4f7ff; border-color: #9bb5f3; }

.task-card.completed { opacity: 0.72; }
.task-card.blocked { border-color: #e4b96d; background: #fffaf0; }

.task-status {
  width: 50rpx;
  height: 50rpx;
  border-radius: 14rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #2f63e8;
  background: #eef5ff;
  font-weight: 800;
}

.task-main { min-width: 0; display: grid; gap: 8rpx; }
.task-title { font-size: 28rpx; line-height: 1.45; }
.task-meta { display: flex; flex-wrap: wrap; gap: 10rpx 16rpx; }
.verification-reason { color: #8a4b08; line-height: 1.45; }

.task-action {
  min-width: 132rpx;
  margin: 0;
  padding: 0 18rpx;
  color: #234ed1;
  background: #eef5ff;
  font-size: 24rpx;
}

.empty-state {
  margin-top: 18rpx;
  padding: 42rpx 28rpx;
  display: grid;
  gap: 16rpx;
  text-align: center;
}
.empty-state.compact { padding: 32rpx 24rpx; }
.empty-title { font-size: 32rpx; }

@media (max-width: 360px) {
  .task-card { grid-template-columns: 48rpx minmax(0, 1fr); }
  .task-action { grid-column: 2; width: 100%; }
}
